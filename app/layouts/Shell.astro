---
import AppHead from '../components/AppHead.astro';
import Sidebar from '../components/Sidebar.astro';
import { brandName, HTML_CLASS, SCHEME_COOKIE, schemeOf, RAIL_COOKIE } from '../lib/ui.ts';
import '../styles/global.css';

interface Props {
  title: string;
  fluid?: boolean;
}
const { title, fluid = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="social" data-scheme={schemeOf(Astro.cookies.get(SCHEME_COOKIE)?.value)} data-rail={Astro.cookies.get(RAIL_COOKIE)?.value === '1' ? '' : undefined} class={HTML_CLASS}>
  <head>
    <AppHead />
    <title>{title} — {brandName}</title>
  </head>
  <body>
    <div class="min-h-screen md:grid md:grid-cols-[240px_minmax(0,1fr)] md:transition-[grid-template-columns] md:in-data-rail:grid-cols-[64px_minmax(0,1fr)]">
      <Sidebar />
      <main class="min-w-0 px-4 pb-8 md:px-12">
        <div class:list={['mx-auto w-full', !fluid && 'max-w-wide']}>
          <slot />
        </div>
      </main>
    </div>
    <slot name="after" />
    <script>
      import '../scripts/account.ts';
      import '../scripts/dialogs.ts';
      import '../scripts/nav.ts';
      import '../scripts/lightbox.ts';
      import '../scripts/newpost.ts';
      import '../scripts/pending.ts';
      import '../scripts/popovers.ts';
      import '../scripts/rail.ts';
      import '../scripts/photos.ts';
      import '../scripts/toast.ts';
      import '../scripts/tooltip.ts';
      import '../scripts/sidebar.ts';
    </script>
  </body>
</html>
