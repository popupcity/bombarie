---
import Button from '@popupcity/ui/src/components/Button.astro';
import Icon from '@popupcity/ui/src/components/Icon.astro';
import Heading from '@popupcity/ui/src/components/Heading.astro';
import Text from '@popupcity/ui/src/components/Text.astro';
import type { Platform } from '../../src/types.ts';

interface Props {
  platform: Platform;
}
interface Step {
  title: string;
  text?: string;
  permissions?: string[];
  link?: { href: string; label: string };
}
const { platform } = Astro.props;
const metaLink = { href: 'https://developers.facebook.com/apps', label: 'Open Meta for developers' };

const steps: Record<string, Step[]> = {
  threads: [
    { title: 'Create the app', text: 'One Threads app serves every Threads channel. In the Meta developer dashboard create an app and add the use case "Access the Threads API".', link: metaLink },
    { title: 'Add the permissions', text: 'Under the use case, add these permissions:', permissions: ['threads_basic', 'threads_content_publish', 'threads_manage_replies', 'threads_manage_insights'] },
    { title: 'Add yourself as a tester', text: 'While the app is in development mode it only posts for Threads testers. Under App roles choose Add People, then Threads Tester. Accept the invitation in Threads under Settings, Account, Website permissions.' },
    { title: 'Save the redirect URL', text: 'Copy the Redirect URL from the channel page and add it under Redirect Callback URLs in the Threads settings.' },
    { title: 'Paste the app details', text: 'Copy the Threads app ID and secret from App settings, Basic, into the fields on the channel page.' }
  ],
  instagram: [
    { title: 'Create the app', text: 'One Meta app serves every Instagram channel. In your Meta app open the Instagram API use case, API setup with Unified login.', link: metaLink },
    { title: 'Add the permissions', text: 'Create a configuration with a system-user access token and your Instagram account as asset, with these permissions:', permissions: ['instagram_basic', 'instagram_content_publish', 'instagram_manage_insights'] },
    { title: 'Save the redirect URL', text: 'Copy the Redirect URL from the channel page and add it in that configuration and under Facebook Login for Business, Valid OAuth Redirect URIs.' },
    { title: 'Paste the app details', text: 'Copy the Meta app ID, the app secret and the configuration ID into the fields on the channel page.' }
  ],
  facebook: [
    { title: 'Create the app', text: 'In your Meta app open the Page use case, Customize. The app ID and secret are the same as for Instagram, but they are saved per platform.', link: metaLink },
    { title: 'Add the permissions', text: 'Create a configuration with a system-user access token and your Page as asset, with these permissions:', permissions: ['pages_show_list', 'pages_manage_posts'] },
    { title: 'Save the redirect URL', text: 'Copy the Redirect URL from the channel page and add it in that configuration and under Facebook Login for Business, Valid OAuth Redirect URIs.' },
    { title: 'Paste the app details', text: 'Copy the Meta app ID, the app secret and the configuration ID into the fields on the channel page.' }
  ],
  linkedin: [
    { title: 'Create the app', text: 'One app serves every LinkedIn channel. Create an app in LinkedIn for developers.', link: { href: 'https://www.linkedin.com/developers/apps', label: 'Open LinkedIn for developers' } },
    { title: 'Add the permissions', text: 'Under Products request "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect". Together they give these scopes:', permissions: ['openid', 'profile', 'w_member_social'] },
    { title: 'Save the redirect URL', text: 'Copy the Redirect URL from the channel page and add it under Auth in your LinkedIn app.' },
    { title: 'Paste the app details', text: 'Copy the client ID and client secret from Auth into the fields on the channel page.' }
  ]
};
const list = steps[platform] ?? [];
---

<ol class="flex flex-col gap-8">
  {
    list.map((step, index) => (
      <li class="flex gap-4">
        <span class="flex size-6 shrink-0 items-center justify-center rounded-full border border-line text-ink">
          <Text as="span" variant="fine">{index + 1}</Text>
        </span>
        <div class="flex min-w-0 flex-1 flex-col gap-2">
          <Heading variant="label" as="h3" class="text-ink!">{step.title}</Heading>
          {step.text && <Text variant="small" class="text-ink-soft">{step.text}</Text>}
          {step.permissions && (
            <div class="flex flex-wrap gap-2">
              {step.permissions.map((name) => (
                <Text as="span" variant="fine" class="rounded-full border border-line px-3 py-1 font-mono text-ink">{name}</Text>
              ))}
            </div>
          )}
          {step.link && (
            <Button href={step.link.href} target="_blank" rel="noopener" variant="outline" class="self-start">
              {step.link.label}
              <Icon name="arrow-square-out" />
            </Button>
          )}
        </div>
      </li>
    ))
  }
</ol>
