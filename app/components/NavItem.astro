---
import Icon from 'ui/src/components/Icon.astro';
import type { IconName } from 'ui/src/components/icons.ts';
import { MENU_ITEM } from '../lib/ui.ts';

interface Props {
  href: string;
  icon: IconName;
  current?: boolean;
}
const { href, icon, current = false } = Astro.props;
---

<a href={href} aria-current={current ? 'page' : undefined} class:list={[MENU_ITEM, 'aria-[current=page]:bg-surface']}>
  <Icon name={icon} class="text-ink-soft text-base" />
  <slot />
</a>
