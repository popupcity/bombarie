---
import Card from '@popupcity/ui/src/components/Card.astro';
import TrashButton from './TrashButton.astro';
import Section from './Section.astro';

interface Props {
  title?: string;
  id?: string;
  remove?: string;
  removeLabel?: string;
  blocked?: string;
  actions?: Record<string, unknown>;
}
const { title, id, remove, removeLabel = 'Delete', blocked, actions = {} } = Astro.props;
const body = Astro.slots.has('default');
---

<Section id={id} title={title}>
  <Card class="flex flex-col gap-4">
    {body && <div class="flex flex-col gap-4 md:pb-2"><slot /></div>}
    {body && <hr class="-mx-4 border-line md:-mx-6" />}
    <div class:list={['flex flex-col gap-4', body && 'md:pt-2']}>
      <div class="group flex items-start gap-3" {...actions}>
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-3"><slot name="actions" /></div>
        {
          remove && (
            <span title={blocked} class="inline-block">
              <TrashButton label={removeLabel} title={blocked ? undefined : removeLabel} data-open={remove} disabled={blocked !== undefined} />
            </span>
          )
        }
      </div>
      <slot name="after" />
    </div>
  </Card>
</Section>
