---
import Card from 'ui/src/components/Card.astro';
import Button from 'ui/src/components/Button.astro';
import Icon from 'ui/src/components/Icon.astro';
import Section from './Section.astro';

interface Props {
  title: string;
  id?: string;
  remove?: string;
  removeLabel?: string;
  blocked?: string;
  actions?: Record<string, unknown>;
}
const { title, id, remove, removeLabel = 'Delete', blocked, actions = {} } = Astro.props;
const body = Astro.slots.has('default');
---

<Section id={id} title={title}>
  <Card class="flex flex-col gap-4">
    <slot />
    {body && <hr class="-mx-6 border-line" />}
    <div class="group flex flex-wrap items-center gap-2" {...actions}>
      {
        remove && (
          <span title={blocked} class="inline-block">
            <Button type="button" variant="outline" tone="bad" icon aria-label={removeLabel} title={blocked ? undefined : removeLabel} data-open={remove} disabled={blocked !== undefined}>
              <Icon name="trash" />
            </Button>
          </span>
        )
      }
      <div class="ml-auto flex flex-wrap items-center justify-end gap-2"><slot name="actions" /></div>
    </div>
    <slot name="after" />
  </Card>
</Section>
