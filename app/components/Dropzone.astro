---
import Icon from '@popupcity/ui/src/components/Icon.astro';
import { ADD_TILE } from '../lib/ui.ts';

interface Props {
  id?: string;
  inputId: string;
  accept: string;
  title: string;
  class?: string;
}
const { id = 'image-dropzone', inputId, accept, title, class: className } = Astro.props;
---

<label id={id} class:list={[ADD_TILE, 'has-focus-visible:outline-2 has-focus-visible:outline-offset-0 has-focus-visible:outline-ink data-active:border-ink data-active:bg-surface data-active:text-ink', className]}>
  <input id={inputId} type="file" accept={accept} multiple class="sr-only" />
  <Icon name="image" class="text-xl" />
  <span>{title}</span>
</label>
