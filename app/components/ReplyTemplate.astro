---
import Button from '@popupcity/ui/src/components/Button.astro';
import Icon from '@popupcity/ui/src/components/Icon.astro';
---

<template id="reply-remove">
  <Button type="button" variant="outline" tone="bad" size="sm" icon aria-label="Remove reply" title="Remove reply" class="absolute top-3 right-3">
    <Icon name="trash" />
  </Button>
