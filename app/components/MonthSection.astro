---
import Heading from '@popupcity/ui/src/components/Heading.astro';
import { monthLabel } from '../../src/calendar.ts';

interface Props {
  month: string;
}
const { month } = Astro.props;
---

<section data-month-section class="flex flex-col gap-4 md:gap-8">
  <Heading variant="page" as="h2" class="pointer-events-none sticky top-0 z-20 max-md:top-16 max-md:bg-page flex h-12 md:h-20 items-center">{monthLabel(month)}</Heading>
  <slot />
</section>
