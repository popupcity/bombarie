---
import Icon from '@popupcity/ui/src/components/Icon.astro';
import type { MonthDay } from '../../src/calendar.ts';
import PostChip from './PostChip.astro';
import { QUIET, VISIBLE_CHIPS } from '../lib/ui.ts';

interface Props {
  day: MonthDay;
  href: string;
  folderCounts?: Record<string, number>;
  anchor?: boolean;
}
const { day, href, folderCounts = {}, anchor = false } = Astro.props;
---

<div
  id={anchor ? 'today' : undefined}
  data-cell={day.inMonth ? day.day : `${day.day}-beside`}
  data-drop-day={day.day}
  class:list={['group/cell relative flex min-h-16 flex-col gap-1 min-w-0 scroll-mt-33 md:scroll-mt-28 rounded-lg bg-surface p-2 md:min-h-36', !day.inMonth ? 'bg-transparent' : day.past && 'bg-page', day.today && day.inMonth ? 'ring-1 ring-inset ring-ink' : 'ring-1 ring-inset ring-line']}
>
  <div class="flex h-8 items-center justify-between max-md:justify-center">
    <a href={href} class:list={['transition rounded-sm px-1 text-sm hover:bg-(--tone-hover) max-md:after:absolute max-md:after:inset-0 max-md:after:rounded-lg', !day.inMonth && 'text-ink-soft']} aria-label={`Open ${day.day}`}>{day.date}</a>
    <button type="button" popovertarget="new-menu" data-day={day.day} title="New post on this day" aria-label={`New post on ${day.day}`} class:list={[QUIET, 'size-8 opacity-0 group-focus-within/cell:opacity-100 group-hover/cell:opacity-100 focus-visible:opacity-100 max-md:hidden']}>
      <Icon name="plus" weight="bold" />
    </button>
  </div>
  <div class:list={['hidden flex-col gap-1 md:flex', !day.inMonth && 'opacity-(--dim)']}>
    <div data-chips class="flex flex-col gap-1 empty:hidden">
      {day.cards.map((card, index) => <PostChip card={card} folded={index >= VISIBLE_CHIPS} siblings={folderCounts[card.id.split('/')[0] ?? ''] ?? 1} />)}
    </div>
    <button data-more data-plain type="button" aria-expanded="false" hidden={day.cards.length <= VISIBLE_CHIPS} class="transition group flex w-fit cursor-pointer items-center gap-1 rounded-sm px-1 py-1 text-xs text-ink-soft hover:text-ink">
      <Icon name="caret-down" class="transition group-aria-expanded:rotate-180" />
      <span data-more-label>{`${day.cards.length - VISIBLE_CHIPS} more`}</span>
    </button>
  </div>
  <span data-dots aria-hidden="true" class:list={['flex h-1 justify-center gap-1 md:hidden', !day.inMonth && 'opacity-(--dim)']}></span>
</div>
