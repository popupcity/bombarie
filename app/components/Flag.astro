---
interface Props {
  code: string;
}
const { code } = Astro.props;
const flags = import.meta.glob<string>('/node_modules/flag-icons/flags/4x3/*.svg', { eager: true, query: '?url', import: 'default' });
const src = flags[`/node_modules/flag-icons/flags/4x3/${code.toLowerCase()}.svg`];
---

{src && <img src={src} alt="" width="16" height="12" loading="lazy" class="h-3 w-4 shrink-0 rounded-xs ring-1 ring-line" />}
