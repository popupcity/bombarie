---
import Alert from 'ui/src/components/Alert.astro';
import Card from 'ui/src/components/Card.astro';
import Heading from 'ui/src/components/Heading.astro';
import Text from 'ui/src/components/Text.astro';
import { PLATFORM_LABEL } from '../../src/types.ts';
import type { CardModel } from '../../src/calendar.ts';
import { sentence } from '../../src/text.ts';
import { coverLabel, isCover, mediaKind } from '../../src/types.ts';
import { cardActions, MENU, postHref } from '../lib/ui.ts';
import Icon from 'ui/src/components/Icon.astro';
import CardActions from './CardActions.astro';
import ChannelMark from './ChannelMark.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  card: CardModel;
  showTime?: boolean;
  siblings?: number;
  menu?: string;
}
const { card, showTime = true, siblings = 1, menu } = Astro.props;
const hasMenu = menu !== undefined && cardActions(card).any;
const menuId = `menu-${menu}`;
const folder = card.id.split('/')[0] ?? '';
const [first, ...others] = card.images;
const source = (name: string): string => `/img/${encodeURIComponent(folder)}/${encodeURIComponent(name.replace(/\.cover\.jpg$/i, ''))}`;
const firstLine = card.text.split('\n').find((line) => line.trim() !== '') ?? '';
---

<li data-channel={card.channel} draggable={cardActions(card).movable ? 'true' : undefined} data-drag-id={cardActions(card).movable ? card.id : undefined} data-drag-day={card.day} data-drag-time={card.time} class="md:grid md:grid-cols-[48px_minmax(0,1fr)] md:gap-4">
  <time class="relative hidden h-8 items-center self-start text-sm text-ink-soft tabular-nums md:mt-6 md:flex">
    {showTime ? card.time : ''}
  </time>
  <Card data-drag-card interactive alert={Boolean(card.problem)} class:list={['relative grid gap-4', first ? 'min-h-40 grid-cols-[minmax(0,1fr)_auto] gap-x-0 overflow-hidden' : 'grid-cols-1']}>
    <div class:list={['flex min-w-0 flex-col gap-4', first && 'pr-6']}>
      <div class="flex min-h-8 flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-soft">
        <time class="tabular-nums md:hidden">{card.time}</time>
        <span class="inline-flex items-center gap-2">
          <span title={`${card.label} on ${PLATFORM_LABEL[card.platform]}`} class="inline-flex"><ChannelMark channel={card} size="sm" on="surface" /></span>
          {card.label}
          {card.type && <span class="rounded-sm bg-track px-2 py-1 text-xs capitalize">{card.type}</span>}
        </span>
        <span class="ml-auto flex items-center gap-2">
          <StatusBadge status={card.status} manual={card.manual} />
          {hasMenu && (
            <button type="button" popovertarget={menuId} aria-label="Actions" title="Actions" style={`anchor-name:--${menuId}`} class="relative z-10 -mr-2 grid size-8 cursor-pointer place-items-center rounded-lg text-lg text-ink-soft hover:bg-page hover:text-ink"><Icon name="dots-three" weight="bold" /></button>
          )}
        </span>
      </div>
      <div class="flex flex-col gap-2">
        <Heading variant="card" as="p" class="truncate"><a href={card.url ?? postHref(card.id)} target={card.url ? '_blank' : undefined} rel={card.url ? 'noopener' : undefined} class="outline-none after:absolute after:inset-0 after:rounded-xl">{card.campaign}</a></Heading>
        <Text variant="small" class:list={['truncate', firstLine ? 'text-ink-soft' : 'text-ink-faint']}>{firstLine || 'No text.'}</Text>
        {card.problem && <Alert variant="plain" role="note">{sentence(card.problem)}</Alert>}
      </div>
    </div>
    {
      first && (
        <div class="relative -my-6 -mr-6 w-30 self-stretch">
          <img src={`/img/${encodeURIComponent(folder)}/${encodeURIComponent(first)}?w=384`} alt="" loading="lazy" data-full={source(first)} data-full-kind={mediaKind(first)} data-full-set={card.id} class="absolute inset-0 size-full cursor-zoom-in object-cover" />
          {isCover(first) && <span class="absolute bottom-2 left-2 rounded-sm bg-veil px-2 py-1 text-xs text-white">{coverLabel(first)}</span>}
          {others.length > 0 && <span class="absolute right-2 bottom-2 rounded-sm bg-veil px-2 py-1 text-xs text-white tabular-nums">+{others.length}</span>}
          {others.map((name) => <span hidden data-full={source(name)} data-full-kind={mediaKind(name)} data-full-set={card.id} />)}
        </div>
      )
    }
    {hasMenu && (
      <div id={menuId} popover style={`position-anchor:--${menuId}`} class:list={[MENU, 'w-60 [inset:auto] [position-try-fallbacks:flip-inline,flip-block] [right:anchor(right)] [top:anchor(bottom)]']}>
        <CardActions card={card} siblings={siblings} />
      </div>
    )}
  </Card>
</li>
