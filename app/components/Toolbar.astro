---
import Button from '@popupcity/ui/src/components/Button.astro';
import Icon from '@popupcity/ui/src/components/Icon.astro';
import type { NoticeModel } from '../../src/calendar.ts';
import Notices from './Notices.astro';
import { SEGMENT, SEGMENTS } from '../lib/ui.ts';

interface Props {
  view: 'month' | 'list';
  notices?: NoticeModel[];
}
const { view, notices = [] } = Astro.props;
const tabs = [
  { id: 'month', label: 'Calendar', href: '/calendar', icon: 'calendar-blank' as const },
  { id: 'list', label: 'List', href: '/', icon: 'list' as const }
];
---

<div class:list={['z-20 -mx-4 flex h-12 md:h-20 items-center gap-3 bg-page px-4 md:sticky md:top-0 md:-mx-12 md:px-12', notices.length === 0 && 'max-md:hidden']}>
  <div class="ml-auto flex items-center gap-3">
    <Notices notices={notices} />
  </div>
  <Button href="#today" variant="outline" class="max-md:hidden">Today</Button>
  <nav data-control class:list={[SEGMENTS, 'max-md:hidden']}>
    {
      tabs.map((tab) => (
        <a href={tab.href} aria-current={tab.id === view ? 'page' : undefined} class={SEGMENT}>
          <Icon name={tab.icon} />
          {tab.label}
        </a>
      ))
    }
  </nav>
</div>
