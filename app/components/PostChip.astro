---
import type { CardModel } from '../../src/calendar.ts';
import { cardActions, STATUS_TONE, TINTED } from '../lib/ui.ts';
import ChannelAvatar from './ChannelAvatar.astro';
import PeekCard from './PeekCard.astro';

interface Props {
  card: CardModel;
  siblings?: number;
}
const { card, siblings = 1 } = Astro.props;
const movable = cardActions(card).movable;
const id = `peek-${card.id.replace(/[^a-zA-Z0-9]/g, '-')}`;
---

<div data-chip data-channel={card.channel} draggable={movable ? 'true' : undefined} data-drag-id={movable ? card.id : undefined} data-drag-day={card.day} data-drag-time={card.time}>
  <button type="button" data-plain popovertarget={id} style={`anchor-name:--${id}`} data-tone={STATUS_TONE[card.status]} class:list={['flex w-full cursor-pointer items-center gap-1 rounded-sm px-1 py-1 text-left text-xs', TINTED]}>
    <ChannelAvatar channel={card} class="size-4 text-[7px]" small />
    {card.manual && <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" class="shrink-0"><polygon points="6,0.5 11.5,6 6,11.5 0.5,6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>}
    <span class="min-w-0 truncate">{card.time} {card.campaign}</span>
  </button>
  <PeekCard id={id} card={card} siblings={siblings} />
</div>
