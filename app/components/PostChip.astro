---
import Icon from '@popupcity/ui/src/components/Icon.astro';
import type { CardModel } from '../../src/calendar.ts';
import { cardActions, STATUS_TONE, TINTED } from '../lib/ui.ts';
import ChannelAvatar from './ChannelAvatar.astro';
import PeekCard from './PeekCard.astro';

interface Props {
  card: CardModel;
  siblings?: number;
}
const { card, siblings = 1 } = Astro.props;
const movable = cardActions(card).movable;
const id = `peek-${card.id.replace(/[^a-zA-Z0-9]/g, '-')}`;
---

<div data-chip data-dot={card.feed ? 'feed' : STATUS_TONE[card.status]} data-channel={card.channel} draggable={movable ? 'true' : undefined} data-drag-id={movable ? card.id : undefined} data-drag-day={card.day} data-drag-time={card.time}>
  <button type="button" data-plain popovertarget={id} style={`anchor-name:--${id}`} data-tone={card.feed ? undefined : STATUS_TONE[card.status]} class:list={['flex w-full cursor-pointer items-center gap-1 rounded-sm px-1 py-1 text-left text-xs', card.feed ? 'bg-track text-ink-soft' : TINTED]}>
    <ChannelAvatar channel={card} class="size-4 text-[7px]" small />
    {card.manual && (
      <span data-tone="manual" title="You post this yourself" class="grid size-4 shrink-0 place-items-center rounded-sm bg-(--tone) text-(--tone-on)">
        <Icon name="hand" class="size-3" />
        <span class="sr-only">Manual</span>
      </span>
    )}
    {card.feed && (
      <span class="grid size-4 shrink-0 place-items-center">
        <Icon name="rss" weight="bold" class="size-3" />
        <span class="sr-only">Feed</span>
      </span>
    )}
    <span class="min-w-0 truncate">{card.time} {card.campaign}</span>
  </button>
  <PeekCard id={id} card={card} siblings={siblings} />
</div>
