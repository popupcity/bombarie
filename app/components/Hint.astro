---
import Icon from 'ui/src/components/Icon.astro';

interface Props {
  text: string;
}
const { text } = Astro.props;
---

<span tabindex="0" role="note" title={text} aria-label={text} class="transition inline-grid size-6 shrink-0 cursor-help place-items-center rounded-lg text-base text-ink-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ink">
  <Icon name="info" />
</span>
