---
import { STATUS_LABEL } from '../../src/calendar.ts';
import type { Status } from '../../src/calendar.ts';
import { STATUS_TONE, TINTED } from '../lib/ui.ts';

interface Props {
  status: Status;
  manual?: boolean;
}
const { status, manual = false } = Astro.props;
const shapes: Record<Status, string> = {
  posted: '<circle cx="6" cy="6" r="4.5" fill="currentColor" />',
  planned: '<circle cx="6" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.5" />',
  draft: '<circle cx="6" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" />',
  reminded: '<polygon points="6,0.5 11.5,6 6,11.5 0.5,6" fill="currentColor" />',
  late: '<polygon points="6,0.5 11.5,11 0.5,11" fill="currentColor" />',
  failed: '<path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />',
  unconfirmed:
    '<circle cx="6" cy="6" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M4.8 4.8a1.3 1.3 0 1 1 1.9 1.1c-.5.3-.7.6-.7 1.1" fill="none" stroke="currentColor" stroke-width="1.2" /><circle cx="6" cy="8.8" r=".7" fill="currentColor" />',
  deleted: '<circle cx="6" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M2.5 9.5l7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />',
  posting:
    '<circle cx="6" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="6" cy="6" r="1.5" fill="currentColor" />'
};
---

{
  manual && (
    <span data-tone="manual" title="You post this yourself" class:list={['inline-flex w-fit items-center gap-1 rounded-sm px-2 py-1 text-xs', TINTED]}>
      <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" class="shrink-0">
        <polygon points="6,0.5 11.5,6 6,11.5 0.5,6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      Manual
    </span>
  )
}
<span data-tone={STATUS_TONE[status]} class:list={['inline-flex w-fit items-center gap-1 rounded-sm px-2 py-1 text-xs', TINTED]}>
  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" class="shrink-0" set:html={shapes[status]} />
  {STATUS_LABEL[status]}
</span>
