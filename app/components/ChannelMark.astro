---
import type { Platform } from '../../src/types.ts';
import ChannelAvatar from './ChannelAvatar.astro';
import PlatformMark from './PlatformMark.astro';

interface Props {
  channel: { label: string; platform: Platform; avatar?: string | undefined };
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'chip';
  on?: 'page' | 'surface';
}
const { channel, size = 'md', on = 'page' } = Astro.props;
const avatar = { sm: 'size-5 text-2xs', md: 'size-7 text-2xs', lg: 'size-8 text-xs', xl: 'size-14 text-lg', chip: 'size-7 text-2xs' }[size];
const mark = { sm: 'size-4 -bottom-1', md: 'size-5 -bottom-1', lg: 'size-5 -bottom-1', xl: 'size-6 -bottom-2', chip: 'size-5 bottom-0' }[size];
const box = { sm: 'w-fit pr-1', md: 'w-fit pr-1', lg: 'w-fit pr-1', xl: 'w-fit pr-2', chip: 'size-8 items-start' }[size];
const ring = { page: 'ring-page', surface: 'ring-surface' }[on];
---

<span class:list={['relative inline-flex shrink-0', box]}>
  <ChannelAvatar channel={channel} class={avatar} small={size === 'sm' || size === 'chip'} />
  <PlatformMark platform={channel.platform} class:list={['absolute right-0 ring-2', mark, ring]} />
</span>
