---
import Icon from '@popupcity/ui/src/components/Icon.astro';
import type { Platform } from '../../src/types.ts';
import ChannelMark from './ChannelMark.astro';
import PlatformMark from './PlatformMark.astro';

interface Props {
  href: string;
  here: boolean;
  channel: { label: string; platform: Platform; avatar?: string | undefined };
  image?: string | undefined;
  text: string;
  type: string;
  when: string;
  value?: string | undefined;
  unit?: string | undefined;
  rank?: number | undefined;
}
const { href, here, channel, image, text, type, when, value, unit, rank } = Astro.props;
---

<a href={href} target={here ? undefined : '_blank'} rel={here ? undefined : 'noopener noreferrer'} class="transition flex items-start gap-3 p-4 md:p-6 hover:bg-(--tone-hover) focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink">
  {rank !== undefined && <span class="w-4 shrink-0 text-right text-sm text-ink-soft tabular-nums">{rank}</span>}
  {
    image ? (
      <span class="relative size-8 shrink-0">
        <img src={image} alt="" loading="lazy" class="size-8 rounded-lg bg-track object-cover" />
        <PlatformMark platform={channel.platform} class="absolute -right-1 -bottom-1 size-5 ring-2 ring-surface" />
      </span>
    ) : (
      <ChannelMark channel={channel} size="lg" on="surface" />
    )
  }
  <span class="flex min-w-0 flex-1 flex-col gap-3">
    <span class:list={['line-clamp-2 text-sm break-words', !text && 'text-ink-faint']}>{text || 'No text.'}</span>
    <span class="flex items-baseline justify-between gap-2 text-xs text-ink-soft">
      <span class="flex min-w-0 items-center"><span class="truncate">{type}</span><Icon name="dot" weight="bold" /><span class="shrink-0">{when}</span></span>
      {value !== undefined && <span class="flex shrink-0 items-baseline gap-1 tabular-nums"><span class="text-base leading-4 text-ink">{value}</span> {unit}</span>}
    </span>
  </span>
</a>
