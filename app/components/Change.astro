---
interface Props {
  value: number;
  unit?: string;
  class?: string;
}
const { value, unit = '', class: className } = Astro.props;
const shown = Math.round(value * 10) / 10 || 0;
const tone = shown > 0 ? 'ok' : shown < 0 ? 'bad' : undefined;
---

<span data-tone={tone} class:list={[tone ? 'text-(--tone-text)' : 'text-ink-soft', className]}>{shown > 0 && '+'}{shown.toLocaleString('en-GB')}{unit}</span>
