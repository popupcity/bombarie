---
interface Props {
  value: number;
  unit?: string;
  class?: string;
}
const { value, unit = '', class: className } = Astro.props;
const tone = value > 0 ? 'ok' : value < 0 ? 'bad' : undefined;
---

<span data-tone={tone} class:list={[tone ? 'text-(--tone-text)' : 'text-ink-soft', className]}>{value > 0 && '+'}{value.toLocaleString('en-GB', { maximumFractionDigits: 1 })}{unit}</span>
