---
import Heading from 'ui/src/components/Heading.astro';
import Button from 'ui/src/components/Button.astro';
import Icon from 'ui/src/components/Icon.astro';
import { channelInfos, loadChannels } from '../../src/channels.ts';
import { loadConnections, root } from '../lib/data.ts';
import { brandName, FADE_BELOW, CARET } from '../lib/ui.ts';
import NewPostMenu from './NewPostMenu.astro';
import AccountMenu from './AccountMenu.astro';
import Wordmark from './Wordmark.astro';
import ChannelGroup from './ChannelGroup.astro';
import NavItem from './NavItem.astro';

const path = Astro.url.pathname;
const connections = await loadConnections();
const channels = channelInfos(loadChannels(root)).map((channel) => ({ ...channel, ...(connections[channel.name] ? { problem: connections[channel.name]! } : {}) }));
const groups: { label: string; avatar: string | undefined; channels: typeof channels }[] = [];
for (const channel of channels) {
  const found = groups.find((group) => group.label.toLowerCase() === channel.label.toLowerCase());
  if (found) found.channels.push(channel);
  else groups.push({ label: channel.label, avatar: channel.avatar, channels: [channel] });
}
const on = (prefix: string) => (prefix === '/' ? path === '/' : path === prefix || path.startsWith(`${prefix}/`));
---

<header class="sticky top-0 z-40 flex h-16 items-center gap-3 bg-page px-4 md:hidden">
  <a href="/" aria-label={brandName} class="mr-auto text-2xl leading-8 [font-family:var(--font-heading)] [font-weight:var(--weight-heading)] [letter-spacing:var(--tracking-heading,0)]"><Wordmark /></a>
  <Button type="button" popovertarget="new-menu" data-with-idea>New<Icon name="caret-down" class={CARET} /></Button>
  <Button type="button" variant="outline" icon data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menu" class="group">
    <span class="relative size-4">
      <span class="absolute inset-0 transition-[opacity,rotate] group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"><Icon name="list" class="size-full" /></span>
      <span class="absolute inset-0 -rotate-90 opacity-0 transition-[opacity,rotate] group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"><Icon name="x" class="size-full" /></span>
    </span>
  </Button>
</header>
<NewPostMenu idea />

<aside id="sidebar" class="[view-transition-name:sidebar] max-md:fixed max-md:inset-x-0 max-md:top-16 max-md:bottom-0 max-md:z-30 max-md:hidden max-md:-translate-y-1 max-md:overflow-y-auto max-md:bg-page max-md:opacity-0 max-md:ease-leave max-md:data-open:ease-pop max-md:transition-[opacity,translate,display] max-md:transition-discrete max-md:data-open:block max-md:data-open:translate-y-0 max-md:data-open:opacity-100 max-md:starting:data-open:-translate-y-1 max-md:starting:data-open:opacity-0 md:sticky md:top-0 md:h-screen">
  <div class="flex min-h-full flex-col gap-8 px-4 max-md:pt-4 md:h-full md:overflow-y-auto">
    <a href="/" aria-label={brandName} class:list={[FADE_BELOW, 'z-10 flex h-20 shrink-0 items-center bg-page px-3 max-md:hidden md:sticky md:top-0 text-2xl leading-8 [font-family:var(--font-heading)] [font-weight:var(--weight-heading)] [letter-spacing:var(--tracking-heading,0)]']}><Wordmark /></a>
    <Button type="button" popovertarget="new-menu" data-with-idea class="w-full max-md:hidden">New<Icon name="caret-down" class={CARET} /></Button>
    <nav aria-label="Main" class="flex flex-col gap-1">
      <NavItem href="/" icon="list" current={path === '/' || path.startsWith('/posts') || path === '/new'}>List</NavItem>
      <NavItem href="/calendar" icon="calendar-blank" current={on('/calendar')}>Calendar</NavItem>
      <NavItem href="/ideas" icon="lightbulb" current={on('/ideas')}>Ideas</NavItem>
      <NavItem href="/entities" icon="at" current={on('/entities')}>Entities</NavItem>
      {Astro.locals.role === 'admin' && <NavItem href="/settings" icon="sliders-horizontal" current={on('/settings')}>Settings</NavItem>}
    </nav>
    <section aria-label="Channels" class="flex flex-1 flex-col gap-4">
      <div class="flex flex-col gap-2">
      <div class="flex min-h-10 items-center justify-between pl-3">
        <Heading variant="label" as="h2">Channels</Heading>
        <div class="flex items-center gap-1">
        <a href="/channels/new" title="Add channel" aria-label="Add channel" aria-current={path === '/channels/new' ? 'page' : undefined} class="transition grid size-8 place-items-center rounded-lg text-base text-ink-soft hover:bg-surface hover:text-ink aria-[current=page]:bg-surface aria-[current=page]:text-ink focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ink">
          <Icon name="plus" />
        </a>
        <a href="/channels" title="Manage channels" aria-label="Manage channels" aria-current={path === '/channels' ? 'page' : undefined} class="transition grid size-8 place-items-center rounded-lg text-base text-ink-soft hover:bg-surface hover:text-ink aria-[current=page]:bg-surface aria-[current=page]:text-ink focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ink">
          <Icon name="gear" />
        </a>
        </div>
      </div>
      <ul class="flex flex-col gap-4">
        {
          groups.map((group) => (
            <li>
              <ChannelGroup label={group.label} avatar={group.avatar} channels={group.channels} />
            </li>
          ))
        }
      </ul>
      </div>
    </section>
    <AccountMenu />
  </div>
</aside>
