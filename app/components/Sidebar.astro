---
import Heading from '@popupcity/ui/src/components/Heading.astro';
import Button from '@popupcity/ui/src/components/Button.astro';
import Icon from '@popupcity/ui/src/components/Icon.astro';
import { channelInfos, loadChannels } from '../../src/channels.ts';
import { loadConnections, root } from '../lib/data.ts';
import { RAIL_COOKIE, brandName, FADE_BELOW, QUIET } from '../lib/ui.ts';
import NewPostMenu from './NewPostMenu.astro';
import AccountMenu from './AccountMenu.astro';
import Wordmark from './Wordmark.astro';
import Logo from './Logo.astro';
import ChannelGroup from './ChannelGroup.astro';
import NavItem from './NavItem.astro';

const BRAND = 'flex items-center gap-2 text-2xl leading-8 [font-family:var(--font-heading)] [font-weight:var(--weight-heading)] [letter-spacing:var(--tracking-heading,0)]';
const path = Astro.url.pathname;
const railed = Astro.cookies.get(RAIL_COOKIE)?.value === '1';
const connections = await loadConnections();
const channels = channelInfos(loadChannels(root)).map((channel) => ({ ...channel, ...(connections[channel.name] ? { problem: connections[channel.name]! } : {}) }));
const groups: { label: string; avatar: string | undefined; channels: typeof channels }[] = [];
for (const channel of channels) {
  const found = groups.find((group) => group.label.toLowerCase() === channel.label.toLowerCase());
  if (found) found.channels.push(channel);
  else groups.push({ label: channel.label, avatar: channel.avatar, channels: [channel] });
}
const on = (prefix: string) => (prefix === '/' ? path === '/' : path === prefix || path.startsWith(`${prefix}/`));
---

<header class="sticky top-0 z-40 flex h-16 items-center gap-3 bg-page px-4 md:hidden">
  <a href="/" aria-label={brandName} class:list={[BRAND, 'mr-auto']}><Logo class="size-8" /><Wordmark /></a>
  <Button type="button" popovertarget="new-menu" data-with-idea><Icon name="plus" weight="bold" />New</Button>
  <Button type="button" variant="outline" icon data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menu" class="group">
    <span class="relative size-4">
      <span class="absolute inset-0 transition-[opacity,rotate] group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"><Icon name="list" class="size-full" /></span>
      <span class="absolute inset-0 -rotate-90 opacity-0 transition-[opacity,rotate] group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"><Icon name="x" class="size-full" /></span>
    </span>
  </Button>
</header>
<NewPostMenu idea />

<aside id="sidebar" class="group/sidebar [view-transition-name:sidebar] max-md:fixed max-md:inset-x-0 max-md:top-16 max-md:bottom-0 max-md:z-30 max-md:hidden max-md:-translate-y-1 max-md:overflow-y-auto max-md:bg-page max-md:opacity-0 max-md:ease-leave max-md:data-open:ease-pop max-md:transition-[opacity,translate,display] max-md:transition-discrete max-md:data-open:block max-md:data-open:translate-y-0 max-md:data-open:opacity-100 max-md:starting:data-open:-translate-y-1 max-md:starting:data-open:opacity-0 md:sticky md:top-0 md:h-screen">
  <div class="flex min-h-full flex-col gap-8 px-4 max-md:pt-5 md:h-full md:overflow-y-auto md:in-data-rail:items-center md:in-data-rail:px-3">
    <div class:list={[FADE_BELOW, 'z-10 flex h-20 shrink-0 items-center justify-between gap-2 bg-page pl-1 max-md:hidden md:sticky md:top-0 md:in-data-rail:justify-center md:in-data-rail:pl-0']}>
      <a href="/" aria-label={brandName} class:list={[BRAND, 'min-w-0 md:in-data-rail:hidden']}><Logo class="size-8" /><span class="truncate"><Wordmark /></span></a>
      <button type="button" data-rail-toggle aria-expanded={railed ? 'false' : 'true'} aria-controls="sidebar" aria-label={railed ? 'Open the sidebar' : 'Close the sidebar'} title={railed ? 'Open the sidebar' : 'Close the sidebar'} class:list={[QUIET, 'group relative size-10 text-lg pointer-fine:not-in-data-rail:opacity-0 pointer-fine:group-hover/sidebar:opacity-100 focus-visible:opacity-100']}>
        <span class="col-start-1 row-start-1 hidden transition-opacity group-hover:opacity-0 group-focus-visible:opacity-0 md:in-data-rail:flex"><Logo class="size-8" /></span>
        <span class="col-start-1 row-start-1 flex transition-opacity md:in-data-rail:opacity-0 md:in-data-rail:group-hover:opacity-100 md:in-data-rail:group-focus-visible:opacity-100"><Icon name="sidebar-simple" /></span>
        <span data-rail-hidden hidden data-tone="warn" class="absolute top-0 right-0 size-2 rounded-full bg-(--tone)"></span>
      </button>
    </div>
    <div class="flex flex-col max-md:hidden md:w-full md:in-data-rail:hidden">
      <Button type="button" popovertarget="new-menu" data-with-idea class="w-full"><Icon name="plus" weight="bold" />New</Button>
    </div>
    <div class="hidden justify-center md:in-data-rail:flex">
      <Button type="button" popovertarget="new-menu" data-with-idea icon aria-label="New" title="New"><Icon name="plus" weight="bold" /></Button>
    </div>
    <nav aria-label="Main" class="flex flex-col gap-1 md:in-data-rail:w-10">
      <NavItem href="/" label="List" icon="list" current={path === '/' || path.startsWith('/posts') || path === '/new'} />
      <NavItem href="/calendar" label="Calendar" icon="calendar-blank" current={on('/calendar')} />
      <NavItem href="/ideas" label="Ideas" icon="lightbulb" current={on('/ideas')} />
      <NavItem href="/entities" label="Entities" icon="at" current={on('/entities')} />
      {Astro.locals.role === 'admin' && <NavItem href="/settings" label="Settings" icon="sliders-horizontal" current={on('/settings')} />}
    </nav>
    <section aria-label="Channels" class="flex flex-1 flex-col gap-4">
      <div class="flex flex-col gap-2 md:in-data-rail:hidden">
      <div class="flex min-h-10 items-center justify-between pl-3">
        <Heading variant="label" as="h2">Channels</Heading>
        <div class="flex items-center gap-1">
        <a href="/channels/new" title="Add channel" aria-label="Add channel" aria-current={path === '/channels/new' ? 'page' : undefined} class:list={[QUIET, 'size-8 text-base aria-[current=page]:bg-surface aria-[current=page]:text-ink']}>
          <Icon name="plus" />
        </a>
        <a href="/channels" title="Manage channels" aria-label="Manage channels" aria-current={path === '/channels' ? 'page' : undefined} class:list={[QUIET, 'size-8 text-base aria-[current=page]:bg-surface aria-[current=page]:text-ink']}>
          <Icon name="gear" />
        </a>
        </div>
      </div>
      <ul class="flex flex-col gap-4">
        {
          groups.map((group) => (
            <li>
              <ChannelGroup label={group.label} avatar={group.avatar} channels={group.channels} />
            </li>
          ))
        }
      </ul>
      </div>
    </section>
    <AccountMenu />
  </div>
</aside>
