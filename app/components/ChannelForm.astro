---
import { quiet } from '../lib/ui.ts';
import Button from '@popupcity/ui/src/components/Button.astro';
import Icon from '@popupcity/ui/src/components/Icon.astro';
import Input from '@popupcity/ui/src/components/Input.astro';
import type { Platform } from '../../src/types.ts';
import ActionPanel from './ActionPanel.astro';
import AppFields from './AppFields.astro';
import Field from './Field.astro';

interface Props {
  formId: string;
  platform: Platform;
  handle?: string;
  feed?: string;
  setup?: { clientId: string; secretSaved: boolean; configId: string; redirectUri: string };
  remove?: { id: string; label: string; blocked?: string };
}
const { formId, platform, handle = '', feed = '', setup, remove } = Astro.props;
const hasFeed = platform === 'substack' || platform === 'feed';
const hint = `${platform === 'substack' ? 'The RSS address of this publication' : 'The address of an RSS or Atom feed'}. The posts it lists show in the List and the Calendar. Nothing is posted ${platform === 'substack' ? 'to Substack ' : ''}from here.`;
---

<div class="grid gap-x-8 gap-y-8 md:gap-y-12 lg:grid-cols-3">
  <form id={formId} method="post" class="flex flex-col gap-4 md:gap-8 lg:col-span-2">
    <slot name="top" />
    <div class="flex flex-wrap items-center gap-3"><slot name="identity" /></div>
    <div class="flex flex-col gap-4">
    {
      platform === 'instagram' && (
        <Field label="Handle" for="handle">
          <Input id="handle" name="handle" label="Handle" value={handle} placeholder="@username" {...quiet} />
        </Field>
      )
    }
    {
      hasFeed && (
        <Field label="Feed address" for="feed" hint={hint}>
          <Input id="feed" name="feed" label="Feed address" value={feed} placeholder={platform === 'substack' ? 'https://name.substack.com/feed' : 'https://example.com/feed/'} {...quiet} />
        </Field>
      )
    }
    <slot name="fields" />
    {
      setup && (
        <>
          <Field label="Redirect URL" for="redirect">
            <div class="flex gap-3">
              <div class="min-w-0 flex-1">
                <Input id="redirect" label="Redirect URL" value={setup.redirectUri} readonly {...quiet} />
              </div>
              <Button id="copy" type="button" variant="outline">Copy</Button>
            </div>
          </Field>
          <AppFields platform={platform} clientId={setup.clientId} secretSaved={setup.secretSaved} configId={setup.configId} />
          <Button href={`/docs/${platform}`} target="_blank" rel="noopener" variant="outline" class="self-start">
            Setup guide
            <Icon name="arrow-square-out" />
          </Button>
        </>
      )
    }
    </div>
  </form>
  <ActionPanel remove={remove?.id} removeLabel={remove?.label} blocked={remove?.blocked}>
    <slot name="rows" />
    <slot name="actions" slot="actions" />
  </ActionPanel>
</div>

<script>
  const copy = document.getElementById('copy');
  const redirect = document.getElementById('redirect') as HTMLInputElement | null;
  copy?.addEventListener('click', async () => {
    if (!redirect) return;
    await navigator.clipboard.writeText(redirect.value);
    copy.textContent = 'Copied';
  });
  redirect?.addEventListener('focus', () => redirect.select());
  document.getElementById('clientSecret')?.addEventListener('focus', (event) => (event.target as HTMLInputElement).select());
</script>
