---
import Alert from 'ui/src/components/Alert.astro';
import Button from 'ui/src/components/Button.astro';
import Card from 'ui/src/components/Card.astro';
import Input from 'ui/src/components/Input.astro';
import Text from 'ui/src/components/Text.astro';
import { githubName } from '../../src/github-login.ts';
import { appsPath, writeUsers } from '../../src/secrets.ts';
import { sentence } from '../../src/text.ts';
import { change } from '../../src/users.ts';
import type { Role } from '../../src/users.ts';
import ActionPanel from '../components/ActionPanel.astro';
import ChoiceMenu from '../components/ChoiceMenu.astro';
import PageHeader from '../components/PageHeader.astro';
import Shell from '../layouts/Shell.astro';
import { users } from '../lib/auth.ts';

const actor = Astro.locals.user ?? '';
if (Astro.locals.role !== 'owner' && Astro.locals.role !== 'admin') return Astro.redirect('/');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const typed = String(form.get('name') ?? '').trim();
  const role = form.get('remove') !== null ? null : (String(form.get('role') ?? 'member') as Role);
  try {
    await writeUsers(appsPath(), change(await users(), actor, form.has('add') ? await githubName(typed) : typed, role));
    return Astro.redirect('/users', 303);
  } catch (err) {
    error = sentence(err instanceof Error ? err.message : String(err));
  }
}
const list = Object.entries(await users()).sort(([a], [b]) => a.localeCompare(b));
const tone: Record<string, string> = { owner: 'ok', admin: 'info', member: 'ink' };
const roles: [Role, string][] = [['owner', 'Can change everything, including owners.'], ['admin', 'Can add and remove users.'], ['member', 'Can sign in and work.']];
---

<Shell title="Users">
  <div class="flex max-w-wide flex-col gap-8">
    <PageHeader title="Users" />
    {error && <Alert>{error}</Alert>}
    <div class="grid gap-8 lg:grid-cols-3">
      <ul class="flex flex-col gap-4 lg:col-span-2">
        {
          list.map(([name, role]) => (
            <Card as="li" class="flex items-center gap-4">
              <img src={`https://github.com/${name}.png?size=64`} alt="" class="size-8 rounded-lg" />
              <Text class="min-w-0 flex-1 truncate">{name}</Text>
              <form method="post" class="flex items-center gap-2">
                <input type="hidden" name="name" value={name} />
                <ChoiceMenu id={`role-${name}`} submit disableActive label={role} tone={tone[role] ?? 'ink'} options={[...roles.map(([value, text]) => ({ label: value, text, active: role === value, attrs: { name: 'role', value } })), { label: 'remove', text: 'Cannot sign in any more.', active: false, attrs: { name: 'remove', value: '1' } }]} />
              </form>
            </Card>
          ))
        }
      </ul>
      <ActionPanel title="Add a user">
        <form id="add-user" method="post" class="flex flex-col gap-2">
          <input type="hidden" name="add" value="1" />
          <Input id="name" name="name" label="GitHub name" placeholder="GitHub name" required autocomplete="off" />
        </form>
        <Button slot="actions" type="submit" form="add-user">Add</Button>
      </ActionPanel>
    </div>
  </div>
</Shell>
