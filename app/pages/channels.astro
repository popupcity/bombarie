---
import Card from 'ui/src/components/Card.astro';
import Heading from 'ui/src/components/Heading.astro';
import Text from 'ui/src/components/Text.astro';
import Icon from 'ui/src/components/Icon.astro';
import Chip from '../components/Chip.astro';
import { channelInfos, loadChannels } from '../../src/channels.ts';
import { readTokens, tokensPath } from '../../src/secrets.ts';
import { PLATFORM_LABEL } from '../../src/types.ts';
import { sentence } from '../../src/text.ts';
import ChannelMark from '../components/ChannelMark.astro';
import PageHeader from '../components/PageHeader.astro';
import { channelState, takeOutcome } from '../lib/connect.ts';
import { loadConnections, root } from '../lib/data.ts';
import Shell from '../layouts/Shell.astro';

const channels = loadChannels(root);
const outcome = takeOutcome();
const toast = outcome && outcome.name === '' ? { tone: outcome.ok ? 'ok' : 'bad', text: sentence(outcome.message) } : null;
const connections = await loadConnections();
let tokens: Awaited<ReturnType<typeof readTokens>> = {};
try {
  tokens = await readTokens(tokensPath());
} catch {
  tokens = {};
}
const until = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const validity = (name: string): string => {
  const expires = tokens[name]?.expiresAt;
  return expires ? `Token valid until ${until.format(expires)}.` : 'Token has no expiry date.';
};
---

<Shell title="Channels">
  <div class="flex flex-col gap-8">
    <PageHeader title="Channels" />
    {toast && <div hidden data-toast={toast.text} data-tone={toast.tone} />}
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        channelInfos(channels).map((info) => {
          const problem = connections[info.name];
          const state = channelState(channels[info.name]!, problem, tokens[info.name]);
          return (
            <li>
              <Card href={`/channels/${encodeURIComponent(info.name)}`} class="flex h-full flex-col gap-4">
                <ChannelMark channel={info} size="xl" on="surface" />
                <div class="flex flex-col gap-2">
                  <Heading variant="card" as="p">{info.label}</Heading>
                  <Text variant="small" class="flex items-center gap-2 text-ink-soft">
                    <span>{PLATFORM_LABEL[info.platform]}</span>
                    <Chip tone={state.tone}>{state.label}</Chip>
                  </Text>
                </div>
                <Text variant="small" class="text-ink-soft">{problem ? sentence(problem) : validity(info.name)}</Text>
              </Card>
            </li>
          );
        })
      }
      <li>
        <a href="/channels/new" class="transition flex h-full min-h-40 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-line-strong p-4 md:p-6 text-ink-soft hover:border-ink-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ink">
          <Icon name="plus" weight="bold" class="text-xl" />
          Add channel
        </a>
      </li>
    </ul>
  </div>
</Shell>
