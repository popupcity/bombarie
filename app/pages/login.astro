---
import Alert from 'ui/src/components/Alert.astro';
import Button from 'ui/src/components/Button.astro';
import Heading from 'ui/src/components/Heading.astro';
import Text from 'ui/src/components/Text.astro';
import { brandName, HTML_CLASS, SCHEME_COOKIE, schemeOf } from '../lib/ui.ts';
import Wordmark from '../components/Wordmark.astro';
import { installed } from '../lib/auth.ts';
import '../styles/global.css';

if (!(await installed())) return Astro.redirect('/setup');
const failure = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en" data-theme="social" data-scheme={schemeOf(Astro.cookies.get(SCHEME_COOKIE)?.value)} class={HTML_CLASS}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Sign in — {brandName}</title>
  </head>
  <body>
    <main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center gap-8 px-6">
      <div class="flex flex-col gap-2">
        <Heading variant="page" as="h1" aria-label={brandName}><Wordmark /></Heading>
        <Text variant="body" class="text-ink-soft">All your noise in one place.</Text>
      </div>
      {failure && <Alert variant="plain">{failure}</Alert>}
      <div>
        <Button href="/login/github" data-pending="Signing in…">Sign in with GitHub</Button>
      </div>
    </main>
  </body>
  <script>
    import '../scripts/pending.ts';
  </script>
</html>
