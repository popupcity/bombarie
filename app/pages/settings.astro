---
import Alert from '@popupcity/ui/src/components/Alert.astro';
import Button from '@popupcity/ui/src/components/Button.astro';
import TrashButton from '../components/TrashButton.astro';
import Card from '@popupcity/ui/src/components/Card.astro';
import Icon from '@popupcity/ui/src/components/Icon.astro';
import Input from '@popupcity/ui/src/components/Input.astro';
import Text from '@popupcity/ui/src/components/Text.astro';
import { githubName } from '../../src/github-login.ts';
import { appsPath, readSetting, writeSetting, writeUsers } from '../../src/secrets.ts';
import { registerWebhook } from '../../src/telegram-intake.ts';
import { sentence } from '../../src/text.ts';
import { change } from '../../src/users.ts';
import type { Role } from '../../src/users.ts';
import Form from '../components/Form.astro';
import ChoiceMenu from '../components/ChoiceMenu.astro';
import Field from '../components/Field.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { githubAvatar } from '../lib/ui.ts';
import Shell from '../layouts/Shell.astro';
import { users } from '../lib/auth.ts';
import { setOutcome, takeOutcome } from '../lib/connect.ts';

const actor = Astro.locals.user ?? '';
if (Astro.locals.role !== 'admin') return Astro.redirect('/');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    if (form.get('part') === 'telegram') {
      const token = String(form.get('token') ?? '').trim();
      const chat = String(form.get('chat') ?? '').trim();
      if ((token === '') !== (chat === '')) throw new Error('fill in both the bot token and the chat ID, or leave both empty');
      await writeSetting(appsPath(), 'telegramToken', token || null);
      await writeSetting(appsPath(), 'telegramChat', chat || null);
      const hooked = token !== '' && Astro.url.protocol === 'https:' ? await registerWebhook(token, Astro.url.origin) : true;
      setOutcome({ name: 'settings', ok: hooked, message: hooked ? 'Saved.' : 'Saved, but Telegram did not accept the address for ideas by message. Check the bot token.' });
    } else {
      const typed = String(form.get('name') ?? '').trim();
      const role = form.get('remove') !== null ? null : (String(form.get('role') ?? 'member') as Role);
      await writeUsers(appsPath(), change(await users(), actor, form.has('add') ? await githubName(typed) : typed, role));
    }
    return Astro.redirect('/settings', 303);
  } catch (err) {
    error = sentence(err instanceof Error ? err.message : String(err));
  }
}
const outcome = takeOutcome();
const toast = outcome?.name === 'settings' ? { tone: outcome.ok ? 'ok' : 'bad', text: sentence(outcome.message) } : null;
const list = Object.entries(await users()).sort(([a], [b]) => a.localeCompare(b));
const token = (await readSetting(appsPath(), 'telegramToken')) ?? '';
const chat = (await readSetting(appsPath(), 'telegramChat')) ?? '';
const cap = (word: string): string => word.charAt(0).toUpperCase() + word.slice(1);
const tone: Record<string, string> = { admin: 'ok', member: 'ink' };
const roles: [Role, string][] = [['admin', 'Can add and remove users.'], ['member', 'Can sign in and work.']];
---

<Shell title="Settings">
  <div class="flex flex-col gap-4 md:gap-8">
    <PageHeader title="Settings" />
    {toast && <div hidden data-toast={toast.text} data-tone={toast.tone} />}
    {error && <Alert>{error}</Alert>}
    <div class="flex flex-col gap-8">
      <Section title="Users">
        <div class="grid gap-4 md:gap-8 lg:grid-cols-3">
          <div class="flex flex-col gap-4 lg:col-span-2">
          <ul class="flex flex-col gap-4">
            {
              list.map(([name, role]) => (
                <Card as="li" class="flex items-center gap-4">
                  <img src={githubAvatar(name)} alt="" class="size-8 rounded-lg" />
                  <Text class="min-w-0 flex-1 truncate">{name}</Text>
                  <form method="post" class="flex items-center gap-3">
                    <input type="hidden" name="name" value={name} />
                    <ChoiceMenu id={`role-${name}`} submit disableActive label={cap(role)} tone={tone[role] ?? 'ink'} options={[...roles.map(([value, text]) => ({ label: cap(value), text, active: role === value, attrs: { name: 'role', value } }))]} />
                    <TrashButton type="submit" name="remove" value="1" label={`Remove ${name}`} title="Remove" />
                  </form>
                </Card>
              ))
            }
          </ul>
          <Card as="form" id="add-user" method="post" hidden class="flex items-center gap-3 data-[open]:flex">
            <input type="hidden" name="add" value="1" />
            <Input id="name" name="name" label="GitHub username" placeholder="GitHub username" required autocomplete="off" />
            <Button type="submit">Add</Button>
          </Card>
          <div><Button id="add-user-open" type="button" variant="outline"><Icon name="plus" weight="bold" />Add user</Button></div>
          </div>
        </div>
      </Section>
      <Section title="Telegram">
        <div class="grid gap-4 md:gap-8 lg:grid-cols-3">
          <div class="lg:col-span-2">
          <Form id="telegram-form">
            <input type="hidden" name="part" value="telegram" />
            <Field label="Bot token" for="token" hint="Reminders and ideas by message. Make a bot with @BotFather and paste its token. Leave both fields empty to turn Telegram off.">
              <Input id="token" name="token" type="password" label="Bot token" value={token} autocomplete="off" />
            </Field>
            <Field label="Chat ID" for="chat" hint="Only this chat is answered. Send a message to @userinfobot to see your ID.">
              <Input id="chat" name="chat" label="Chat ID" value={chat} autocomplete="off" />
            </Field>
            <Button slot="actions" type="submit" data-pending="Saving…">Save</Button>
          </Form>
          </div>
        </div>
      </Section>
    </div>
  </div>
  <Fragment slot="after">
    <script>
      const open = document.getElementById('add-user-open');
      const form = document.getElementById('add-user');
      open?.addEventListener('click', () => {
        if (!form) return;
        form.hidden = false;
        open.hidden = true;
        form.querySelector('input')?.focus();
      });
    </script>
  </Fragment>
</Shell>
