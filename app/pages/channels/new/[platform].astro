---
import Text from 'ui/src/components/Text.astro';
import Alert from 'ui/src/components/Alert.astro';
import Button from 'ui/src/components/Button.astro';
import { addChannel, PLATFORMS, setFeed, setHandle } from '../../../../src/channels.ts';
import { feedUrlProblem } from '../../../../src/feed.ts';
import { PLATFORM_LABEL } from '../../../../src/types.ts';
import { sentence } from '../../../../src/text.ts';
import { callbackUrl } from '../../../lib/connect.ts';
import ChannelForm from '../../../components/ChannelForm.astro';
import Heading from 'ui/src/components/Heading.astro';
import PlatformMark from '../../../components/PlatformMark.astro';
import TitleField from '../../../components/TitleField.astro';
import { quiet, STATIC_CHIP } from '../../../lib/ui.ts';
import { appSaved, saveApp, setOutcome, startConnect } from '../../../lib/connect.ts';
import { root } from '../../../lib/data.ts';
import Shell from '../../../layouts/Shell.astro';

const platform = PLATFORMS.find((candidate) => candidate === Astro.params.platform);
if (!platform) return new Response('Not found', { status: 404 });

const instagram = platform === 'instagram';
const facebook = platform === 'facebook';
const meta = instagram || facebook;
const threads = platform === 'threads';
const connectable = platform === 'linkedin' || meta || threads;
const hasFeed = platform === 'substack' || platform === 'feed';
const savedApp = connectable ? await appSaved(platform).catch(() => null) : null;

let error = '';
let values = { name: '', handle: '', feed: '', clientId: '', clientSecret: '', configId: '' };
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (key: string): string => String(form.get(key) ?? '').trim();
  values = { name: text('name'), handle: text('handle'), feed: text('feed'), clientId: text('clientId'), clientSecret: text('clientSecret'), configId: text('configId') };
  const connect = form.get('intent') === 'connect';
  try {
    const feedProblem = hasFeed && values.feed !== '' ? feedUrlProblem(values.feed) : null;
    if (feedProblem) throw new Error(feedProblem);
    const appGiven = connectable && !savedApp && [values.clientId, values.clientSecret, values.configId].some((field) => field !== '');
    if (appGiven) await saveApp(platform, values, Astro.url.origin);
    const key = await addChannel(root, { platform, name: values.name });
    if (instagram) await setHandle(root, key, values.handle);
    if (hasFeed) await setFeed(root, key, values.feed);
    const ready = connectable && (savedApp !== null || appGiven);
    if (connect && ready) return Astro.redirect(await startConnect(root, key, Astro.url.origin), 303);
    setOutcome({ name: key, ok: true, message: `${values.name} is added.${connectable && !ready ? ' Fill in the app details below to connect it.' : ''}` });
    return Astro.redirect(`/channels/${encodeURIComponent(key)}`, 303);
  } catch (err) {
    error = sentence(err instanceof Error ? err.message : String(err));
  }
}
const redirectUri = callbackUrl(Astro.url.origin);
---

<Shell title="Add channel">
  <div class="flex flex-col gap-8">
    <header class="flex h-20 items-center">
      <Heading variant="page" as="h1" class="sr-only">{`Add ${PLATFORM_LABEL[platform]} channel`}</Heading>
      <div class="min-w-0 flex-1">
        <TitleField form="add-form" name="name" value={values.name} placeholder="Name" aria-label="Name" required pattern=".*[A-Za-z0-9À-ÿ].*" title="Use at least one letter or number." autofocus {...quiet} />
      </div>
    </header>
    <ChannelForm formId="add-form" platform={platform} handle={values.handle} feed={values.feed} setup={connectable && !savedApp ? { clientId: values.clientId, secretSaved: false, configId: values.configId, redirectUri } : undefined}>
      {error && <Alert slot="top">{error}</Alert>}
      <div slot="identity" class={`${STATIC_CHIP} pl-2`}>
        <PlatformMark platform={platform} class="size-6" />
        <span>{PLATFORM_LABEL[platform]}</span>
      </div>
      <Text slot="rows" variant="small" class="text-ink-soft">{connectable ? `Saves the channel and opens ${PLATFORM_LABEL[platform]} so you can give access.` : 'Saves the channel.'}</Text>
      <Button slot="actions" type="submit" form="add-form" name="intent" value={connectable ? 'connect' : 'add'} >{connectable ? 'Connect channel' : 'Add channel'}</Button>
    </ChannelForm>
  </div>
</Shell>
