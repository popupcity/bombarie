---
import Button from '@popupcity/ui/src/components/Button.astro';
import Card from '@popupcity/ui/src/components/Card.astro';
import Heading from '@popupcity/ui/src/components/Heading.astro';
import Text from '@popupcity/ui/src/components/Text.astro';
import { channelInfos, loadChannels } from '../../src/channels.ts';
import { METRICS, SORTS, UNITS, grouped, timeline, before, dailyOf, passedOn, passedOnLine, followerLine, followersOf, metricOf, momentsOf, othersShare, rangeOf, scale, since, sortOf, summed, topPosts, viewTotal } from '../../src/insights.ts';
import type { Daily, Metric, Range, Sort } from '../../src/insights.ts';
import { readPosts } from '../../src/posts.ts';
import { historiesOf, placeKindOf, placeName, sharesOf } from '../../src/audience.ts';
import { PLACE_KINDS, readStats } from '../../src/stats.ts';
import type { PlaceKind } from '../../src/stats.ts';
import { shortDay, ymd } from '../../src/time.ts';
import { PLATFORM_LABEL, needsCover } from '../../src/types.ts';
import ChannelChip from '../components/ChannelChip.astro';
import Change from '../components/Change.astro';
import Chart from '../components/Chart.astro';
import ChoiceMenu from '../components/ChoiceMenu.astro';
import ChannelMark from '../components/ChannelMark.astro';
import Spark from '../components/Spark.astro';
import StatTile from '../components/StatTile.astro';
import PostRow from '../components/PostRow.astro';
import PageHeader from '../components/PageHeader.astro';
import Shell from '../layouts/Shell.astro';
import { root, states } from '../lib/data.ts';
import { PANEL, SEGMENT, SEGMENTS, SERIES, SERIES_LINES, postHref } from '../lib/ui.ts';
import type { Tip } from '../lib/ui.ts';

const PAGE = 5;
const RANGE_COOKIE = 'bombarie_stats_range';
const now = new Date();
const query = Astro.url.searchParams;
const range = rangeOf(query.get('range') ?? Astro.cookies.get(RANGE_COOKIE)?.value);
if (query.has('range')) Astro.cookies.set(RANGE_COOKIE, range, { path: '/', maxAge: 31_536_000, sameSite: 'lax' });
const sort = sortOf(query.get('sort'));
const shown = Math.max(Number(query.get('top')) || PAGE, PAGE);
const from = since(range, now);
const earlier = before(range, now);
const metric = metricOf(query.get('metric'));
const where = placeKindOf(query.get('audience'));
const opened = query.get('place') ?? '';
const listed = Math.max(Number(query.get('places')) || PAGE, PAGE);
const mentioned = Math.max(Number(query.get('tags')) || PAGE, PAGE);

const channels = loadChannels(root);
const measured = channelInfos(channels)
  .map((info) => ({ info, days: readStats(root, info.name, 'days'), posts: readStats(root, info.name, 'posts') }))
  .filter((channel) => channel.days.length > 0 || channel.posts.length > 0);
const hidden = new Set((query.get('hide') ?? '').split(',').filter((name) => measured.some((channel) => channel.info.name === name)));
const picked = measured.filter((channel) => !hidden.has(channel.info.name));
const accounts = picked.map((channel) => ({ days: channel.days, posts: channel.posts, platform: channel.info.platform }));
const people = picked.map((channel) => followersOf(channel.days, from));
const counted = people.filter((found) => found.followers !== null);
const followers = {
  value: counted.length > 0 ? counted.reduce((total, found) => total + found.followers!, 0) : null,
  change: counted.length > 0 && counted.every((found) => found.change !== null) ? counted.reduce((total, found) => total + found.change!, 0) : null
};
const views = viewTotal(accounts, from, earlier);
const spread = passedOn(accounts, from, earlier);
const trends = { followers: followerLine(accounts, from), views: summed(accounts, 'views', from), spread: passedOnLine(accounts, from, ymd(now)) };
const unit = UNITS[range];
const take = metric === 'followers' ? 'last' : 'sum';
const column: Daily = metric === 'new' ? 'reach_others' : metric === 'reach' ? 'reach' : 'views';
const daily = metric === 'followers' ? followerLine(accounts, from) : summed(accounts, column, from);
const points = grouped(daily, unit, take);
const own = picked.map((channel, index) => (metric === 'followers' ? followerLine([accounts[index]!], from) : dailyOf(channel.days, column, from)));
const rows = picked.map((channel, index) => ({
  info: channel.info,
  fill: SERIES[measured.indexOf(channel) % SERIES.length]!,
  daily: grouped(own[index]!, unit, take),
  value: metric === 'followers' ? people[index]!.followers : own[index]!.length > 0 ? own[index]!.reduce((total, point) => total + point.value, 0) : null,
  change: metric === 'followers' ? people[index]!.change : null,
  share: metric === 'new' ? othersShare(channel.days, from) : null
}));
const widest = Math.max(...rows.map((row) => row.value ?? 0), 1);
const audienceRows = new Map(measured.map((channel) => [channel.info.name, readStats(root, channel.info.name, 'audience')]));
const located = [...audienceRows.values()].some((found) => found.length > 0);
const places = sharesOf(picked.map((channel) => audienceRows.get(channel.info.name)!), where, from);
const first = [daily[0]?.date, ...own.map((line) => line[0]?.date)].filter((date) => date !== undefined).sort()[0] ?? ymd(now);
const time = timeline(first > from ? first : from, ymd(now), unit);
const top = topPosts(picked.map((channel) => ({ channel: channel.info.name, platform: channel.info.platform, posts: channel.posts })), sort, from);
const ownNames = new Set(channelInfos(channels).flatMap((info) => [info.label, channels[info.name]?.handle ?? '']).map((name) => name.replace(/^@/, '').toLowerCase()).filter(Boolean));
const tagFiles = measured.map((channel) => ({ info: channel.info, rows: readStats(root, channel.info.name, 'tags') }));
const tagging = tagFiles.some((file) => file.rows.length > 0);
const tags = tagFiles
  .filter((file) => !hidden.has(file.info.name))
  .flatMap((file) => file.rows.map((row) => ({ info: file.info, by: row.by ?? '', url: row.url!, day: ymd(new Date(row.date!)) })))
  .filter((tag) => tag.day >= from && !ownNames.has(tag.by.toLowerCase()))
  .sort((a, b) => b.day.localeCompare(a.day) || a.url.localeCompare(b.url));
const percent = (value: number): string => `${value.toLocaleString('en-GB', { maximumFractionDigits: 1 })}%`;
const courseOf = (place: string) => {
  const histories = historiesOf(picked.map((channel) => audienceRows.get(channel.info.name)!), where, place, from);
  const lines = picked.flatMap((channel, index) => {
    const points = grouped(histories[index]!, unit, 'last');
    const colour = measured.indexOf(channel) % SERIES.length;
    return points.length > 0 ? [{ info: channel.info, fill: SERIES[colour]!, stroke: SERIES_LINES[colour]!, points }] : [];
  });
  const points = [...new Map(lines.flatMap((line) => line.points).map((point) => [point.date, point])).values()].sort((a, b) => a.date.localeCompare(b.date));
  const values = lines.flatMap((line) => line.points.map((point) => point.value));
  return {
    lines,
    points,
    time: timeline(points[0]?.date ?? ymd(now), ymd(now), unit),
    grid: scale(values, false),
    said: (point: { date: string }): Tip => ({
      title: bucketLabel(point.date),
      rows: lines.flatMap((line) => {
        const at = line.points.findIndex((own) => own.date === point.date);
        const own = line.points[at];
        const earlier = line.points[at - 1];
        return own ? [{ fill: line.fill, channel: line.info, value: percent(own.value), change: earlier && own.value - earlier.value }] : [];
      })
    })
  };
};
const infoOf = new Map(measured.map((channel) => [channel.info.name, channel.info]));

const made = new Map<string, { href: string; image?: string }>();
for (const post of readPosts(root, channels).posts) {
  const state = await states.get(post.id);
  if (state?.status !== 'posted' || !state.url) continue;
  const [folder = ''] = post.id.split('/');
  const first = post.images[0];
  made.set(state.url, { href: postHref(post.id), ...(first && { image: `/img/${encodeURIComponent(folder)}/${encodeURIComponent(needsCover(first) ? `${first}.cover.jpg` : first)}?size=96` }) });
}

const posted = new Map<string, ReturnType<typeof momentsOf>>();
if (unit === 'day') {
  for (const post of momentsOf(picked.map((channel) => ({ channel: channel.info.name, posts: channel.posts })), first > from ? first : from)) {
    posted.set(post.day, [...(posted.get(post.day) ?? []), post]);
  }
}
const colourOf = (channel: string): string => SERIES[measured.findIndex((found) => found.info.name === channel) % SERIES.length]!;

const marks = [...posted].map(([day, posts]) => ({ date: day, fills: posts.map((post) => colourOf(post.channel)), said: `${posts.length === 1 ? '1 post' : `${posts.length} posts`} on ${shortDay(day, now)}`, opens: `posts-${day}` }));

const href = (change: { range?: Range; hide?: string[]; metric?: Metric; sort?: Sort; top?: number; audience?: PlaceKind; places?: number; tags?: number; place?: string }): string => {
  const next = { range, hide: [...hidden], metric, sort, top: 0, audience: where, places: 0, tags: 0, place: opened, ...change };
  const params = new URLSearchParams();
  params.set('range', next.range);
  if (next.hide.length > 0) params.set('hide', next.hide.join(','));
  if (next.metric !== 'views') params.set('metric', next.metric);
  if (next.sort !== 'views') params.set('sort', next.sort);
  if (next.top > PAGE) params.set('top', String(next.top));
  if (next.audience !== 'country') params.set('audience', next.audience);
  if (next.places > PAGE) params.set('places', String(next.places));
  if (next.tags > PAGE) params.set('tags', String(next.tags));
  if (next.place) params.set('place', next.place);
  return `/stats?${params.toString().replaceAll('%2C', ',')}`;
};

const RANGE_LABELS: Record<Range, string> = { week: 'Week', month: 'Month', quarter: 'Quarter', year: 'Year', all: 'All time' };
const SORT_LABELS: Record<Sort, string> = { views: 'Views', likes: 'Likes', replies: 'Replies', follows: 'Follows' };
const ONE: Record<Sort, string> = { views: 'view', likes: 'like', replies: 'reply', follows: 'follow' };
const PLACE_LABELS: Record<PlaceKind, string> = { country: 'Countries', city: 'Cities' };
const METRIC_LABELS: Record<Metric, string> = { views: 'Views', reach: 'Reach', new: 'New', followers: 'Followers' };
const METRIC_NAMES: Record<Metric, string> = { views: 'Views', reach: 'Reach', new: 'New reach', followers: 'Followers' };
const compact = (value: number): string => value.toLocaleString('en-GB', { notation: 'compact', maximumFractionDigits: 1 });
const number = (value: number): string => value.toLocaleString('en-GB');
const dayLabel = (day: string): string => shortDay(day, now);
const bucketLabel = (day: string): string =>
  unit === 'month' ? new Date(`${day}T12:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : unit === 'week' ? `Week of ${dayLabel(day)}` : dayLabel(day);
const split = (point: { date: string; value: number }): string | Tip => {
  const found = metric === 'followers' ? [] : rows.flatMap((row) => {
    const own = row.daily.find((entry) => entry.date === point.date);
    return own && own.value > 0 ? [{ fill: row.fill, channel: row.info, value: number(own.value) }] : [];
  });
  return found.length > 0 ? { title: bucketLabel(point.date), total: number(point.value), rows: found } : `${bucketLabel(point.date)}: ${number(point.value)}`;
};
---

<Shell title="Stats">
  <div data-view="stats" class="flex flex-col gap-4 md:gap-8">
    <div class="flex flex-col gap-4 xl:sticky xl:top-0 xl:z-20 xl:-mx-12 xl:flex-row xl:items-center xl:justify-between xl:bg-page xl:px-12">
      <PageHeader title="Stats" />
      {
        measured.length > 0 && (
          <nav aria-label="Period" class:list={[SEGMENTS, 'w-fit max-w-full']}>
            {(Object.keys(RANGE_LABELS) as Range[]).map((key) => (
              <a href={href({ range: key })} aria-current={key === range ? 'page' : undefined} class={`${SEGMENT} max-sm:px-2`}>{RANGE_LABELS[key]}</a>
            ))}
          </nav>
        )
      }
    </div>
    {
      measured.length === 0 ? (
        <Text variant="body" class="text-ink-soft">No numbers yet.</Text>
      ) : (
        <div class="flex flex-col gap-4 md:gap-8">
          <nav aria-label="Channels" class="flex flex-wrap gap-3">
            {measured.map(({ info }) => {
            const off = hidden.has(info.name);
            const named = `${info.label} on ${PLATFORM_LABEL[info.platform]}`;
            return <ChannelChip channel={info} href={href({ hide: off ? [...hidden].filter((name) => name !== info.name) : [...hidden, info.name] })} said={`${off ? 'Show' : 'Hide'} ${named}`} active={!off} current="true" named={false} grey={off} />;
            })}
          </nav>
          {picked.length === 0 ? (
            <Text variant="body" class="text-ink-faint">All channels are switched off.</Text>
          ) : (
            <div class="flex flex-col gap-8">
              <div class="@container">
                <ul aria-label="At a glance" class="grid gap-4 md:gap-8 @2xl:grid-cols-3">
                  <li class="contents">
                    <StatTile label="Followers" trend={trends.followers} fromZero={false} value={followers.value === null ? '–' : number(followers.value)} change={followers.change ?? undefined} note={counted.length === 1 ? '1 account' : `${counted.length} accounts`} />
                  </li>
                  <li class="contents">
                    <StatTile label="Views" trend={trends.views} value={number(views.value)} change={views.change ?? undefined} />
                  </li>
                  <li class="contents">
                    <StatTile label="Shared and saved" trend={trends.spread} value={number(spread.value)} change={spread.change ?? undefined} note={`from ${spread.posts === 1 ? '1 post' : `${number(spread.posts)} posts`}`} />
                  </li>
                </ul>
              </div>
              <div class="grid items-start gap-8 xl:grid-cols-3">
                <section aria-label="Audience" class="flex min-w-0 flex-col gap-8 xl:col-span-2">
                  <div class="flex flex-col gap-4">
                    <div class="flex min-h-10 flex-wrap items-center justify-between gap-4">
                      <Heading variant="block" as="h2">{metric === 'followers' ? 'Followers' : `${METRIC_NAMES[metric]} per ${unit}`}</Heading>
                      <nav aria-label="Show" class:list={[SEGMENTS, 'w-fit']}>
                        {METRICS.map((key) => (
                          <a href={href({ metric: key })} aria-current={key === metric ? 'page' : undefined} aria-label={METRIC_NAMES[key]} class={`${SEGMENT} max-sm:px-3`}>{METRIC_LABELS[key]}</a>
                        ))}
                      </nav>
                    </div>
                    {[...posted].map(([day, posts]) => (
                      <div id={`posts-${day}`} popover data-float="start" aria-label={`Posts on ${dayLabel(day)}`} class:list={[PANEL, 'w-80 max-w-[calc(100vw-16px)] divide-y divide-line p-0']}>
                        {posts.map((post) => {
                          const own = made.get(post.url);
                          return <PostRow href={own?.href ?? post.url} here={Boolean(own)} channel={infoOf.get(post.channel)!} image={own?.image} text={post.text} type={post.type} when={dayLabel(post.day)} value={post.views === null ? undefined : number(post.views)} unit={post.views === 1 ? 'view' : 'views'} />;
                        })}
                      </div>
                    ))}
                    <Card class="flex flex-col gap-4">
                      {points.length > (metric === 'followers' ? 1 : 0) ? (
                        <Chart kind={metric === 'followers' ? 'line' : 'bars'} points={points} time={time} grid={scale(points.map((point) => point.value), metric !== 'followers')} number={compact} class="h-64" label={`${METRIC_NAMES[metric]} of the channels shown`} said={split} marks={marks} parts={metric === 'followers' ? undefined : rows.map((row) => ({ fill: row.fill, points: row.daily }))} />
                      ) : (
                        <Text variant="body" class="flex h-64 items-center justify-center text-center text-ink-faint">No data yet.</Text>
                      )}
                    </Card>
                  </div>
                  <Card as="ul" variant="bare" class="divide-y divide-line">
                    {rows.toSorted((a, b) => (b.value ?? -1) - (a.value ?? -1)).map((row) => (
                      <li class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 p-4 md:p-6">
                        <ChannelMark channel={row.info} size="lg" on="surface" />
                        <span class="flex min-w-0 flex-col gap-2">
                          <span class="flex items-baseline justify-between gap-4">
                            <span class="min-w-0 truncate text-sm">{row.info.label}<span class="sr-only"> on {PLATFORM_LABEL[row.info.platform]}</span></span>
                            <span class="flex shrink-0 items-baseline gap-2 tabular-nums">
                              <span>{row.value === null ? '–' : number(row.value)}</span>
                              {row.change !== null && <Change value={row.change} class="text-xs" />}
                              {row.share !== null && <span class="text-xs text-ink-soft">{Math.round(row.share)}%</span>}
                            </span>
                          </span>
                          <svg aria-hidden="true" class="block h-3 w-full">
                            {row.value !== null && row.value > 0 && <rect width={`${(row.value / widest) * 100}%`} height="100%" rx="4" class={row.fill} />}
                          </svg>
                        </span>
                      </li>
                    ))}
                  </Card>
                  {located && (
                    <div class="flex flex-col gap-4">
                      <div class="flex min-h-10 flex-wrap items-center justify-between gap-4">
                        <Heading variant="block" as="h2">Audience</Heading>
                        <nav aria-label="Audience by" class:list={[SEGMENTS, 'w-fit']}>
                          {PLACE_KINDS.map((key) => (
                            <a href={href({ audience: key, place: '', places: key === where ? listed : 0 })} aria-current={key === where ? 'page' : undefined} class={SEGMENT}>{PLACE_LABELS[key]}</a>
                          ))}
                        </nav>
                      </div>
                      {places.length === 0 ? (
                        <Text variant="body" class="text-ink-faint">No data yet.</Text>
                      ) : (
                        <Card as="ul" variant="bare" class="divide-y divide-line">
                          {places.slice(0, listed).map((found) => {
                            const name = placeName(where, found.place);
                            const open = found.place === opened;
                            const course = open ? courseOf(found.place) : null;
                            return (
                              <li>
                                <a href={href({ place: open ? '' : found.place, places: listed, top: shown, tags: mentioned })} data-place={found.place} aria-expanded={open ? 'true' : 'false'} class="transition grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 p-4 md:p-6 hover:bg-(--tone-hover) focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_128px]" data-tip={`${name}: ${number(found.count)} people`}>
                                  <span class="min-w-0 truncate text-sm">{name}</span>
                                  <span class="hidden min-w-0 sm:block">
                                    <Spark points={found.points} fromZero={false} />
                                  </span>
                                  <span class="flex items-baseline justify-end gap-2 tabular-nums">
                                    <span>{found.share.toLocaleString('en-GB', { maximumFractionDigits: 1, minimumFractionDigits: 1 })}%</span>
                                    {found.change !== null && <Change value={found.change} unit=" pt" class="text-xs" />}
                                  </span>
                                </a>
                                {course && course.points.length > 0 && (
                                  <div class="p-4 md:p-6">
                                    <Chart kind="line" points={course.points} parts={course.lines} time={course.time} grid={course.grid} number={percent} class="h-48" label={`Share of ${name} per channel`} said={course.said} />
                                  </div>
                                )}
                              </li>
                            );
                          })}
                        </Card>
                      )}
                      {places.length > listed && <div><Button href={href({ places: listed + PAGE, top: shown, tags: mentioned })} data-more-places variant="outline">Show {Math.min(PAGE, places.length - listed)} more</Button></div>}
                    </div>
                  )}
                </section>

                <section aria-label="Top posts" class="flex min-w-0 flex-col gap-4">
                  <div class="flex min-h-10 flex-wrap items-center justify-between gap-4">
                    <Heading variant="block" as="h2">Top posts</Heading>
                    <ChoiceMenu id="sort-menu" said="Sort by " label={SORT_LABELS[sort]} tone="ink" options={SORTS.map((key) => ({ label: SORT_LABELS[key], active: key === sort, attrs: { href: href({ sort: key }) } }))} />
                  </div>
                  {top.length === 0 ? (
                    <Text variant="body" class="text-ink-faint">No posts in this period.</Text>
                  ) : (
                    <Card as="ul" variant="bare" class="divide-y divide-line overflow-hidden">
                      {top.slice(0, shown).map((post, index) => {
                        const own = made.get(post.url);
                        const info = infoOf.get(post.channel)!;
                        return (
                          <li>
                            <PostRow href={own?.href ?? post.url} here={Boolean(own)} channel={info} image={own?.image} text={post.text} type={post.type} when={dayLabel(post.day)} value={number(post.value)} unit={post.value === 1 ? ONE[sort] : SORT_LABELS[sort].toLowerCase()} rank={index + 1} />
                          </li>
                        );
                      })}
                    </Card>
                  )}
                  {top.length > shown && <div><Button href={href({ top: shown + PAGE })} data-more-posts variant="outline">Show {Math.min(PAGE, top.length - shown)} more</Button></div>}
                  {tagging && (
                    <div class="flex flex-col gap-4 pt-4">
                      <div class="flex min-h-10 items-center justify-between gap-4">
                        <Heading variant="block" as="h2">Tagged by</Heading>
                        <span class="tabular-nums">{number(tags.length)}</span>
                      </div>
                      {tags.length === 0 ? (
                        <Text variant="body" class="text-ink-faint">No tags in this period.</Text>
                      ) : (
                        <Card as="ul" variant="bare" class="divide-y divide-line overflow-hidden">
                          {tags.slice(0, mentioned).map((tag) => (
                            <li>
                              <a href={tag.url} target="_blank" rel="noopener noreferrer" class="transition flex items-center gap-3 p-4 md:p-6 hover:bg-(--tone-hover) focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink">
                                <ChannelMark channel={tag.info} size="lg" on="surface" />
                                <span class="min-w-0 flex-1 truncate text-sm">{tag.by || 'Unknown'}</span>
                                <span class="shrink-0 text-xs text-ink-soft">{dayLabel(tag.day)}</span>
                              </a>
                            </li>
                          ))}
                        </Card>
                      )}
                      {tags.length > mentioned && <div><Button href={href({ tags: mentioned + PAGE })} data-more-tags variant="outline">Show {Math.min(PAGE, tags.length - mentioned)} more</Button></div>}
                    </div>
                  )}
                </section>
              </div>
            </div>
          )}
        </div>
      )
    }
  </div>
  <Fragment slot="after">
    <script>
      import '../scripts/stats.ts';
    </script>
  </Fragment>
</Shell>
