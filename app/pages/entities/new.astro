---
import { addEntity } from '../../../src/entities.ts';
import { sentence } from '../../../src/text.ts';
import EntityForm from '../../components/EntityForm.astro';
import Heading from '@popupcity/ui/src/components/Heading.astro';
import TitleField from '../../components/TitleField.astro';
import { setOutcome } from '../../lib/connect.ts';
import { root } from '../../lib/data.ts';
import { quiet } from '../../lib/ui.ts';
import Shell from '../../layouts/Shell.astro';

let error = '';
let values = { name: '', linkedin: '', instagram: '' };
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = { name: String(form.get('name') ?? ''), linkedin: String(form.get('linkedin') ?? ''), instagram: String(form.get('instagram') ?? '') };
  try {
    const name = await addEntity(root, values);
    setOutcome({ name: 'entity', ok: true, message: `${name} is added.` });
    return Astro.redirect('/entities', 303);
  } catch (err) {
    error = sentence(err instanceof Error ? err.message : String(err));
  }
}
---

<Shell title="Add entity">
  <div class="flex flex-col gap-8">
    <header class="flex h-20 items-center">
      <Heading variant="page" as="h1" class="sr-only">Add entity</Heading>
      <div class="min-w-0 flex-1">
        <TitleField form="entity-form" name="name" value={values.name} placeholder="Name" aria-label="Name" required autofocus {...quiet} />
      </div>
    </header>
    <div class="lg:w-2/3">
      <EntityForm linkedin={values.linkedin} instagram={values.instagram} error={error} />
    </div>
  </div>
</Shell>
