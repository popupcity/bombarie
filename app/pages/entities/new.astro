---
import Button from 'ui/src/components/Button.astro';
import { addEntity } from '../../../src/entities.ts';
import { sentence } from '../../../src/text.ts';
import ActionPanel from '../../components/ActionPanel.astro';
import EntityForm from '../../components/EntityForm.astro';
import PageHeader from '../../components/PageHeader.astro';
import { setOutcome } from '../../lib/connect.ts';
import { root } from '../../lib/data.ts';
import Shell from '../../layouts/Shell.astro';

let error = '';
let values = { name: '', linkedin: '', instagram: '' };
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = { name: String(form.get('name') ?? ''), linkedin: String(form.get('linkedin') ?? ''), instagram: String(form.get('instagram') ?? '') };
  try {
    const name = await addEntity(root, values);
    setOutcome({ name: 'entity', ok: true, message: `${name} is added.` });
    return Astro.redirect('/entities', 303);
  } catch (err) {
    error = sentence(err instanceof Error ? err.message : String(err));
  }
}
---

<Shell title="Add entity">
  <div class="flex max-w-wide flex-col gap-8">
    <PageHeader title="Add entity" />
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <EntityForm {...values} error={error} />
      </div>
      <ActionPanel title="Save">
        <Button slot="actions" type="submit" form="entity-form">Save</Button>
      </ActionPanel>
    </div>
  </div>
</Shell>
