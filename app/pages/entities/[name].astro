---
import { entityMentions, findEntity, removeEntity, updateEntity } from '../../../src/entities.ts';
import { sentence } from '../../../src/text.ts';
import ConfirmDialog from '../../components/ConfirmDialog.astro';
import EntityForm from '../../components/EntityForm.astro';
import TitleField from '../../components/TitleField.astro';
import TrashButton from '../../components/TrashButton.astro';
import Heading from 'ui/src/components/Heading.astro';
import { setOutcome, takeOutcome } from '../../lib/connect.ts';
import { root } from '../../lib/data.ts';
import Shell from '../../layouts/Shell.astro';

const entity = findEntity(root, Astro.params.name ?? '');
if (!entity) return new Response('Not found', { status: 404 });
const mentions = entityMentions(root, entity.name);
const blocked = mentions > 0 ? `${mentions} ${mentions === 1 ? 'post mentions' : 'posts mention'} it, so it cannot be deleted.` : undefined;

let failure = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  try {
    if (intent === 'delete') {
      await removeEntity(root, entity.name);
      setOutcome({ name: 'entity', ok: true, message: `${entity.name} is deleted.` });
      return Astro.redirect('/entities', 303);
    }
    const saved = await updateEntity(root, entity.slug, { name: String(form.get('name') ?? ''), linkedin: String(form.get('linkedin') ?? ''), instagram: String(form.get('instagram') ?? '') });
    setOutcome({ name: 'entity', ok: true, message: saved.posts > 0 ? `Saved. Updated ${saved.posts} ${saved.posts === 1 ? 'post' : 'posts'}.` : 'Saved.' });
    return Astro.redirect(`/entities/${saved.slug}`, 303);
  } catch (err) {
    failure = sentence(err instanceof Error ? err.message : String(err));
  }
}
const outcome = takeOutcome();
const toast = failure ? { tone: 'bad', text: failure } : outcome && outcome.name === 'entity' ? { tone: outcome.ok ? 'ok' : 'bad', text: sentence(outcome.message) } : null;
---

<Shell title={entity.name}>
  <div class="flex max-w-wide flex-col gap-8">
    <header class="flex h-20 items-center">
      <Heading variant="page" as="h1" class="sr-only">{entity.name}</Heading>
      <div class="min-w-0 flex-1">
        <TitleField form="entity-form" name="name" value={entity.name} />
      </div>
    </header>
    {toast && <div hidden data-toast={toast.text} data-tone={toast.tone} />}
    <div class="lg:w-2/3">
      <EntityForm linkedin={entity.linkedin ?? ''} instagram={entity.instagram ?? ''}>
        <span slot="actions" title={blocked} class="ml-auto inline-block">
          <TrashButton label="Delete entity" title={blocked ? undefined : 'Delete entity'} data-open="delete-entity" disabled={blocked !== undefined} />
        </span>
      </EntityForm>
    </div>
    <ConfirmDialog id="delete-entity" title={`Delete ${entity.name}?`} intent="delete" variant={entity.name} confirm="Delete">
      This removes the note from the entities folder.
    </ConfirmDialog>
  </div>
</Shell>
